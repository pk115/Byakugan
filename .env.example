SUPAPULSE_PORT=3000
SUPAPULSE_HOST=0.0.0.0
SUPAPULSE_DATA_DIR=./data
# Generate with: openssl rand -hex 32
SUPAPULSE_MASTER_KEY=
SUPAPULSE_SESSION_SECRET=
# Set true only when SupaPulse is served through HTTPS.
SUPAPULSE_SECURE_COOKIES=false
# Recommended behind a reverse proxy, for example https://monitor.example.com
SUPAPULSE_PUBLIC_ORIGIN=
# Reverse proxies in front of the app (Cloudflare Tunnel or Caddy = 1). It makes rate limits and audit logs use the real client IP.
# Set it only when the app port is reachable solely through the proxy (bind to 127.0.0.1); 0 uses the socket address.
SUPAPULSE_TRUST_PROXY_HOPS=0
# Drain traffic and pause schedulers during verified migration/cutover.
SUPAPULSE_MAINTENANCE_MODE=false
